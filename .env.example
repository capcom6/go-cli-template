# Environment Configuration Template for go-cli-template
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Debug Mode
# Purpose: Enables debug logging for the whole CLI; equivalent to passing the
#   --debug flag on the root command (internal/app.go Before hook raises the
#   logger level to debug when set)
# Format: Boolean (true|false)
# Default: false
# Example: false
# Example: true
DEBUG=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level
# Purpose: Minimum log level emitted by go-core-fx/cli-logger; messages below
#   this level are dropped (read once at startup via logger.NewDefault)
# Format: debug|info|warn|error|fatal (case-insensitive; unknown values fall back to info)
# Default: info
# Example: debug
LOG_LEVEL=info

# Log Format
# Purpose: Selects the log line renderer used by go-core-fx/cli-logger:
#   human-readable colored text or machine-parseable JSON
# Format: human|json (case-insensitive; only "json" switches format)
# Default: human
# Example: json
LOG_FORMAT=human

# Log Output Destination
# Purpose: Where go-core-fx/cli-logger writes log lines: a stream or a file
#   path (a file is created/extended with mode 0644; on open failure the
#   logger falls back to stderr)
# Format: stdout|stderr|<file path> (case-insensitive for stream names; empty = stderr)
# Default: stderr
# Example: stdout
# Example: stderr
# Example: ./logs/app.log
LOG_OUTPUT=stderr

# No Color
# Purpose: Disables colorized output in the human log format (NO_COLOR
#   convention); colors stay enabled when the variable is unset or empty
# Format: Any non-empty value disables colors (e.g. 1, true)
# Default: unset (colors enabled)
# Example: 1
NO_COLOR=

# =============================================================================
# EXAMPLE COMMAND CONFIGURATION
# =============================================================================

# Example Command Value
# Purpose: Default value for the example command's --value flag, echoed back
#   by the one-shot task (env source for the flag in internal/commands/example)
# Format: Non-empty string
# Default: example
# Example: foo
EXAMPLE__VALUE=example
